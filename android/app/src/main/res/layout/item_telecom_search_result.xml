<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/dividerHorizontal">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tv_site_id"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="I-WB-KGPU-ENB-9036"
          android:textAppearance="?attr/textAppearanceSubtitle1"
          android:textStyle="bold"
          android:textColor="?attr/colorAccent" />

      <TextView
          android:id="@+id/tv_site_type"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="ENB"
          android:textAppearance="?attr/textAppearanceCaption"
          android:background="@drawable/bg_search_radius"
          android:paddingHorizontal="6dp"
          android:paddingVertical="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_site_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="MOHAMMADPUR"
        android:textAppearance="?attr/textAppearanceBody2" />

    <TextView
        android:id="@+id/tv_location_tech"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="JC: KHARAGPUR | Tech: AMALESH MONDAL"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tv_coordinates"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="22.072423, 87.341914"
          android:textAppearance="?attr/textAppearanceCaption"
          android:textColor="?android:attr/textColorSecondary" />

      <ImageView
          android:id="@+id/btn_quick_nav"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:src="@drawable/ic_route_to"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Navigate"
          android:padding="4dp" />

      <ImageView
          android:id="@+id/btn_quick_copy"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:layout_marginStart="8dp"
          android:src="@drawable/ic_share"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="Copy"
          android:padding="4dp" />

    </LinearLayout>

  </LinearLayout>

</com.google.android.material.card.MaterialCardView>
