<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <com.google.android.material.appbar.AppBarLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Telecom Data Management"
        app:navigationIcon="?attr/homeAsUpIndicator" />

  </com.google.android.material.appbar.AppBarLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

      <!-- Database Statistics Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="8dp"
          app:cardElevation="2dp"
          android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Stored Dataset Statistics"
              android:textAppearance="?attr/textAppearanceSubtitle1"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/tv_stats_total"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Total Site Records: 0"
              android:textAppearance="?attr/textAppearanceBody2" />

          <TextView
              android:id="@+id/tv_stats_coords"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Sites with Valid Coordinates: 0"
              android:textAppearance="?attr/textAppearanceBody2" />

          <!-- Map Layer Controls -->
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:layout_marginVertical="10dp"
              android:background="?attr/dividerHorizontal" />

          <com.google.android.material.switchmaterial.SwitchMaterial
              android:id="@+id/switch_map_layer"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Show Telecom Sites Layer on Map"
              android:textAppearance="?attr/textAppearanceBody1" />

          <Button
              android:id="@+id/btn_sync_map"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="Sync All Sites to Map Placemarks" />

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <!-- CSV Import Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="8dp"
          app:cardElevation="2dp"
          android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Import Telecom Records (CSV)"
              android:textAppearance="?attr/textAppearanceSubtitle1"
              android:textStyle="bold" />

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="Select a CSV file exported from Microsoft Excel. Columns will be auto-mapped with support for custom headers."
              android:textAppearance="?attr/textAppearanceCaption"
              android:textColor="?android:attr/textColorSecondary" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="10dp"
              android:text="Import Strategy:"
              android:textAppearance="?attr/textAppearanceCaption"
              android:textStyle="bold" />

          <RadioGroup
              android:id="@+id/rg_import_mode"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rb_mode_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Update existing &amp; add new records (Recommended)" />

            <RadioButton
                android:id="@+id/rb_mode_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add new records only (Keep existing unchanged)" />

            <RadioButton
                android:id="@+id/rb_mode_replace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace entire dataset (Requires confirmation)" />

          </RadioGroup>

          <Button
              android:id="@+id/btn_import_csv"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:text="Select CSV or Excel (.xlsx) File" />

          <Button
              android:id="@+id/btn_load_demo_data"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Load Demo Dataset (Infra Tracker)" />

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <!-- CSV Export Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="8dp"
          app:cardElevation="2dp"
          android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Backup &amp; Export (CSV)"
              android:textAppearance="?attr/textAppearanceSubtitle1"
              android:textStyle="bold" />

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="Export your locally stored telecom dataset to a standard UTF-8 CSV backup file."
              android:textAppearance="?attr/textAppearanceCaption"
              android:textColor="?android:attr/textColorSecondary" />

          <Button
              android:id="@+id/btn_export_csv"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:text="Export Dataset to CSV" />

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <!-- Last Import Summary Card -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_import_summary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="8dp"
          app:cardElevation="2dp"
          android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Last Import Summary"
              android:textAppearance="?attr/textAppearanceSubtitle1"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/tv_import_summary_text"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:textAppearance="?attr/textAppearanceBody2" />

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

  </ScrollView>

</LinearLayout>
